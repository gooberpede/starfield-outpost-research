root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf

[docs/experiments/evidence/**]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false

[docs/experiments/evidence/**/README.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[docs/experiments/evidence/README.md]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[LICENSE]
trim_trailing_whitespace = false
